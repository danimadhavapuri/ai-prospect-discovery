# Google Gemini API Key (Required for AI query parsing and prospect synthesis)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (Required for multi-platform real-time web discovery)
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Gemini Model Selection
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# In-Memory Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_MAXSIZE=1000

# Network and Concurrency Limits
SEARCH_TIMEOUT_SECONDS=10.0
HTTP_TIMEOUT_SECONDS=5.0
MAX_SEARCH_CONCURRENCY=5
MAX_TAVILY_QUERIES_PER_REQUEST=6

# Security & Limits
MAX_RESPONSE_BYTES=1048576

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=4000
ENVIRONMENT=development
